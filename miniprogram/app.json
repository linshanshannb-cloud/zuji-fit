{
  "pages": [
    "pages/calendar/calendar",
    "pages/library/library",
    "pages/body/body",
    "pages/diet/diet"
  ],
  "subpackages": [
    { "root": "pages/diet-formula", "pages": ["diet-formula"] },
    { "root": "pages/diet-extra", "pages": ["diet-goal/diet-goal", "diet-review/diet-review", "diet-log/diet-log", "diet-meal/diet-meal", "diet-day/diet-day"] },
    { "root": "pages/diet-ai", "pages": ["input/input", "result/result"] },
    { "root": "pages/workout-detail", "pages": ["workout-detail"] },
    { "root": "pages/workout-edit", "pages": ["workout-edit"] },
    { "root": "pages/templates", "pages": ["templates"] },
    { "root": "pages/template-detail", "pages": ["template-detail"] },
    { "root": "pages/aerobic-detail", "pages": ["aerobic-detail"] },
    { "root": "pages/aerobic-edit", "pages": ["aerobic-edit"] },
    { "root": "pages/exercise-picker", "pages": ["exercise-picker"] },
    { "root": "pages/exercise-detail", "pages": ["exercise-detail"] },
    { "root": "pages/custom-exercise-edit", "pages": ["custom-exercise-edit"] },
    { "root": "pages/body-edit", "pages": ["body-edit"] },
    { "root": "pages/settings", "pages": ["settings"] },
    { "root": "pages/about", "pages": ["about"] },
    { "root": "pages/journal-pack", "pages": ["hold"] }
  ],
  "preloadRule": {
    "pages/calendar/calendar": { "network": "all", "packages": ["pages/journal-pack"] }
  },
  "window": {
    "navigationStyle": "custom",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#ffffff",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "color": "#8C8C8C",
    "selectedColor": "#FF5A1F",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/calendar/calendar",
        "text": "日历",
        "iconPath": "images/tabbar/calendar.png",
        "selectedIconPath": "images/tabbar/calendar-active.png"
      },
      {
        "pagePath": "pages/library/library",
        "text": "动作库",
        "iconPath": "images/tabbar/library.png",
        "selectedIconPath": "images/tabbar/library-active.png"
      },
      {
        "pagePath": "pages/diet/diet",
        "text": "饮食",
        "iconPath": "images/tabbar/diet.png",
        "selectedIconPath": "images/tabbar/diet-active.png"
      },
      {
        "pagePath": "pages/body/body",
        "text": "身体数据",
        "iconPath": "images/tabbar/body.png",
        "selectedIconPath": "images/tabbar/body-active.png"
      }
    ]
  },
  "usingComponents": {
    "nav-bar": "/components/nav-bar/nav-bar",
    "btn": "/components/btn/btn",
    "card": "/components/card/card",
    "empty-state": "/components/empty-state/empty-state",
    "undo-toast": "/components/undo-toast/undo-toast",
    "month-calendar": "/components/month-calendar/month-calendar",
    "line-chart": "/components/line-chart/line-chart",
    "set-row": "/components/set-row/set-row",
    "swipe-cell": "/components/swipe-cell/swipe-cell",
    "rest-timer": "/components/rest-timer/rest-timer"
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
