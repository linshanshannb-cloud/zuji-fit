.subtabs { margin-top: 8rpx; }
.date-nav { margin-top: 28rpx; }
.date-btn { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; font-size: 44rpx; }
.date-btn.off { color: var(--c-disabled); }
.block { margin-top: 24rpx; }
.macro-row { display: flex; margin-top: 12rpx; }
.macro { flex: 1; min-width: 0; }
.macro-n { font-size: 40rpx; font-weight: 700; line-height: 1.2; }
.unit { font-size: 22rpx; color: var(--c-text-3); font-weight: 400; margin-left: 4rpx; }
.note { background: var(--c-accent-weak); border-radius: var(--r-card); padding: 20rpx 24rpx; margin-top: 24rpx; color: var(--c-text-2); font-size: 26rpx; }
.unlogged { font-size: 48rpx; font-weight: 700; padding: 12rpx 0 4rpx; }
.week { display: flex; margin-top: 12rpx; }
.week-cell { flex: 1; text-align: center; padding: 12rpx 0; border-radius: 12rpx; }
.week-cell.on { background: var(--c-ink); color: var(--c-white); }
.week-cell.on .cap { color: var(--c-white); }
.tiny { font-size: 20rpx; line-height: 1.3; }
.stack { margin-top: 28rpx; }
.lab { width: 220rpx; }
.choice { margin-top: 8rpx; }
.entry-line { min-height: 88rpx; }
