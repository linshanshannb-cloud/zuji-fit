<nav-bar mode="tab" title="饮食">
  <view slot="right" class="nav-actions">
    <view class="nav-ico" bindtap="openGoal">
      <view class="ico-goal"></view>
      <text class="nav-lab">目标</text>
    </view>
    <view class="nav-ico" bindtap="openReview">
      <view class="ico-review"></view>
      <text class="nav-lab">回顾</text>
    </view>
  </view>
</nav-bar>
<view class="page page-pad-tab">
  <empty-state wx:if="{{loadError}}" title="饮食数据读取异常" sub="{{loadError}}"></empty-state>
  <block wx:else>
    <view class="row between date-nav">
      <view class="date-btn" bindtap="shiftDate" data-d="-1">‹</view>
      <picker mode="date" value="{{date}}" end="{{todayStr}}" bindchange="onPickDate">
        <text class="h2">{{dateTitle}}</text>
      </picker>
      <view class="date-btn {{canNext?'':'off'}}" bindtap="shiftDate" data-d="1">›</view>
    </view>

    <view class="intake">
      <view class="row between">
        <text class="h2">今日摄入</text>
        <text wx:if="{{board.badge}}" class="tag tag-accent">{{board.badge}}</text>
      </view>
      <view class="row between kcal-row">
        <text class="kcal-main num">{{board.kcalLine}}</text>
        <text class="remain">{{board.remain}}</text>
      </view>
      <view wx:for="{{board.rows}}" wx:key="key" class="macro-line">
        <view class="row between">
          <text>{{item.name}}</text>
          <text class="sub num">{{item.right}}</text>
        </view>
        <view class="track"><view class="fill" style="width: {{item.bar}}%;"></view></view>
        <view wx:if="{{item.gap}}" class="cap">{{item.gap}}</view>
      </view>
    </view>

    <view class="record {{readOnly?'off':''}}" bindtap="openAi">马上记录</view>

    <view class="row between stack">
      <text class="h2">今日记录</text>
      <view class="row">
        <text class="sub">{{board.mealCount}} 餐</text>
        <text wx:if="{{board.recorded && !readOnly}}" class="more" bindtap="openMore">⋯</text>
      </view>
    </view>
    <view wx:if="{{board && !board.recorded}}" class="empty-copy">这一天还没有饮食记录。</view>
    <view wx:for="{{board.meals}}" wx:key="id" class="meal" bindtap="openMeal" data-meal="{{item.id}}">
      <view class="flex1">
        <view class="meal-name">{{item.label}}</view>
        <view class="cap ell">{{item.summary}}</view>
      </view>
      <text class="num meal-kcal">{{item.kcal}} kcal</text>
      <text class="chev">›</text>
    </view>
    <view wx:if="{{!hasPlan}}" class="cap goal-hint" bindtap="openGoal">还没有饮食目标。点这里设置。没设目标时，这一天不会被当成吃了 0。</view>
  </block>
</view>
