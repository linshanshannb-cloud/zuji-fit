<nav-bar mode="back" title="分享当天"></nav-bar>
<view class="page share-page">
  <view wx:if="{{busy}}" class="wait">正在生成手账…</view>
  <view wx:elif="{{fail}}" class="wait">{{fail}}</view>
  <image wx:else class="preview" src="{{path}}" mode="widthFix" />
  <view class="actions">
    <view class="btn btn-sec {{!path ? 'is-off' : ''}} {{saving ? 'is-busy' : ''}}"
          hover-class="{{path && !saving ? 'is-press' : 'none'}}" hover-stay-time="80" bindtap="save">
      <view wx:if="{{saving}}" class="spin"></view>
      <view wx:elif="{{saved}}" class="tick"></view>
      <text>{{saving ? '保存中…' : (saved ? '已保存' : '保存图片')}}</text>
    </view>
    <button class="btn btn-pri" hover-class="is-press" hover-stay-time="80" open-type="share" disabled="{{!path}}">发给好友</button>
  </view>
</view>
<canvas type="2d" id="card" class="card-canvas"></canvas>
