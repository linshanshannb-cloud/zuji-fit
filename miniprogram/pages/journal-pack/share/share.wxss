page { background: #F6F3EE; }
.share-page { padding: 24rpx 40rpx calc(32rpx + env(safe-area-inset-bottom)); }
.wait { text-align: center; color: #6B6560; font-size: 28rpx; padding: 80rpx 0; }
.preview { width: 100%; border-radius: 20rpx; box-shadow: 0 16rpx 56rpx rgba(44, 36, 30, 0.14); background: #F6F3EE; }
.actions { margin-top: 40rpx; display: flex; align-items: center; }
.btn { flex: 1; min-width: 0; height: 96rpx; border-radius: 48rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center; font-size: 32rpx; line-height: 1; }
.btn + .btn { margin-left: 24rpx; }

.btn-sec { background: transparent; border: 1px solid #D9D1C6; color: #2C241E; font-weight: 500; }
.btn-sec.is-press { background: rgba(44, 36, 30, 0.05); border-color: #CFC6BA; }
.btn-sec.is-off, .btn-sec.is-busy { color: #A89F94; border-color: #E3DBD0; }
.spin { width: 28rpx; height: 28rpx; margin-right: 12rpx; border-radius: 50%; box-sizing: border-box;
  border: 4rpx solid #E3DBD0; border-top-color: #5C5854; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.tick { width: 18rpx; height: 10rpx; margin: -6rpx 14rpx 0 0; border-left: 4rpx solid #5C5854; border-bottom: 4rpx solid #5C5854; transform: rotate(-45deg); }

/* 原生 button 重置：v2 默认宽度、外边距、内边距和行高 */
button.btn-pri { width: auto !important; margin: 0 0 0 24rpx !important; padding: 0 !important;
  height: 96rpx; line-height: 1; border-radius: 48rpx; border: none;
  background: #FC5B21; color: #fff; font-size: 32rpx; font-weight: 600; box-shadow: none; }
button.btn-pri::after { border: none; }
button.btn-pri.is-press { background: #E04E17; }
button.btn-pri[disabled] { background: #F6C2AC !important; color: #fff !important; opacity: 1; }
.card-canvas { position: fixed; left: -4000rpx; top: 0; width: 10rpx; height: 10rpx; }
