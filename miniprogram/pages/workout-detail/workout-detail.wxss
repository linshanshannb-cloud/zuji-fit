.page.repeat-pad { padding-bottom: calc(300rpx + env(safe-area-inset-bottom) + 32rpx); }
.repeat-bar { flex-direction: column; align-items: stretch; }
.repeat-row { display: flex; align-items: center; margin-top: 16rpx; }
.session-line { margin-top: 8rpx; line-height: 1.4; }
.stat-grid { display: flex; flex-wrap: wrap; margin: 24rpx -12rpx 8rpx; }
.stat-cell { width: 50%; box-sizing: border-box; padding: 12rpx; min-width: 0; }
.stat-box { background: var(--c-bg-2); border-radius: 16rpx; padding: 20rpx 16rpx 16rpx; min-height: 148rpx; box-sizing: border-box; }
.sv { font-size: 44rpx; font-weight: 700; line-height: 1.2; overflow-wrap: break-word; }
.stat-unit { font-size: 26rpx; font-weight: 600; }
.stat-hint { margin-top: 6rpx; font-size: 22rpx; line-height: 1.35; color: var(--c-text-3); }
.th { height: 64rpx; margin-top: 16rpx; } .tr { height: 88rpx; }
.c1 { width: 80rpx; } .c2 { flex: 1; } .c3 { width: 140rpx; text-align: right; }
.warm { display: inline-block; background: var(--c-bg-2); color: var(--c-text-2); border-radius: 8rpx; padding: 0 10rpx; font-size: 24rpx; width: auto; margin-right: 32rpx; }
.faded { opacity: .45; }
