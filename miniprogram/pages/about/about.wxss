.about { padding-top: 16rpx; padding-bottom: 96rpx; }
.about .h2 { margin-top: 40rpx; margin-bottom: 8rpx; }
.p { font-size: var(--fs-sub); color: var(--c-text-2); line-height: 1.7; margin-top: 8rpx; }
