page { background: #F6F3EE; }
.screen { box-sizing: border-box; padding-bottom: 48rpx; }

.mode-switch {
  width: 280rpx; height: 76rpx; margin: 12rpx auto 0; padding: 6rpx; box-sizing: border-box;
  display: flex; background: #E4DFD9; border-radius: 999rpx;
}
.mode-item {
  flex: 1; display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: #5F574F; border-radius: 999rpx;
}
.mode-item.on { background: #fff; color: #1A1A1A; font-weight: 600; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.06); }
.camera-hint { margin-top: 16rpx; text-align: center; font-size: 26rpx; color: #5F574F; }

.time { margin-top: 48rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; }
.time-t { font-size: 36rpx; font-weight: 700; color: #1A1A1A; }
.time-pen { margin-left: 12rpx; font-size: 32rpx; color: #1A1A1A; }

.box-wrap { margin: 24rpx 48rpx 0; }
.box {
  width: 100%; height: 168rpx; box-sizing: border-box; padding: 28rpx 32rpx;
  background: #fff; border-radius: 40rpx; font-size: 32rpx; line-height: 1.5; color: #1A1A1A;
}
.ph { color: #8A8078; }
.priv { margin: 20rpx 48rpx 0; font-size: 26rpx; line-height: 36rpx; color: #5F574F; text-align: center; white-space: nowrap; }

.fail { margin: 24rpx 48rpx 0; background: #fff; border-radius: 28rpx; padding: 24rpx 28rpx; }
.fail-t { font-size: 32rpx; font-weight: 600; color: #1A1A1A; }
.fail-p { margin-top: 8rpx; font-size: 26rpx; line-height: 1.5; color: #5F574F; }
.fail-acts { display: flex; margin-top: 20rpx; }
.fail-btn {
  flex: 1; height: 72rpx; border-radius: 999rpx; background: #E4DFD9; color: #1A1A1A;
  display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600;
}
.fail-btn.solid { margin-left: 16rpx; background: #1A1A1A; color: #fff; }

.dock { margin-top: 48rpx; display: flex; align-items: center; justify-content: center; }
.dock.up { position: fixed; left: 0; right: 0; margin-top: 0; z-index: 6; }
.round, .check {
  width: 112rpx; height: 112rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; font-size: 40rpx;
}
.round { margin-right: 80rpx; background: #fff; color: #1A1A1A; box-shadow: 0 8rpx 28rpx rgba(60,50,40,.08); }
.check { background: #C0BFBB; color: #fff; }
.check.on { background: #1A1A1A; }
.check.busy { width: auto; padding: 0 36rpx; border-radius: 999rpx; font-size: 28rpx; font-weight: 600; }
