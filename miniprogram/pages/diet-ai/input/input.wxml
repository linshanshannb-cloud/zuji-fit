<nav-bar mode="back" title="" tone="warm" custom-back bind:back="cancel"></nav-bar>
<view class="screen">
  <view class="mode-switch">
    <view class="mode-item {{tab==='camera'?'on':''}}" bindtap="useCamera">相机</view>
    <view class="mode-item {{tab==='text'?'on':''}}" bindtap="useText">输入</view>
  </view>

  <block wx:if="{{tab==='text'}}">
    <picker mode="time" value="{{time}}" bindchange="onTime">
      <view class="time">
        <text class="time-t">{{timeLabel}}</text>
        <text class="time-pen">✎</text>
      </view>
    </picker>
    <view class="box-wrap">
      <textarea
        class="box"
        maxlength="200"
        placeholder="如：下午吃了一块巧克力"
        placeholder-class="ph"
        value="{{text}}"
        bindinput="onText"
        bindkeyboardheightchange="onKeyboard"
        adjust-position="{{false}}"
        show-confirm-bar="{{false}}"
        cursor-spacing="24"
      />
    </view>
    <view class="priv">这句话只用于这次识别，不保存原文，也不收集个人信息。</view>
    <view wx:if="{{failText}}" class="fail">
      <view class="fail-t">{{failTitle}}</view>
      <view class="fail-p">{{failText}}</view>
      <view class="fail-acts">
        <view class="fail-btn" bindtap="clearFail">再试一次</view>
        <view class="fail-btn solid" bindtap="manual">手动录入</view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="finder">
      <text class="finder-t">{{finderNote}}</text>
    </view>
  </block>
</view>

<view class="dock {{keyboardHeight ? 'key' : ''}}" style="bottom: {{keyboardHeight}}px;">
  <view wx:if="{{tab==='text'}}" class="cluster">
    <view class="round" bindtap="cancel">×</view>
    <!-- 中间空档对齐参考图里「按住说话」的位置。语音本期不做，也不申请麦克风。 -->
    <view class="gap"></view>
    <view class="round check {{canSend || loading ? 'on' : ''}}" bindtap="confirm">{{loading ? '…' : '✓'}}</view>
  </view>
  <view wx:else class="cam">
    <view class="round" bindtap="cancel">×</view>
    <view class="shutter" bindtap="cameraLater"></view>
    <view class="round" bindtap="cameraLater"><view class="album"></view></view>
  </view>
</view>
