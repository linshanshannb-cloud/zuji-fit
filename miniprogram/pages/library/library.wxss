.nav-right { display: flex; align-items: center; margin-left: 16rpx; }
.custom-entry { margin-left: 20rpx; font-weight: 600; }
.page-lib { padding-bottom: 0; height: auto; overflow: hidden; }
.lib-top { padding-bottom: 8rpx; }
.more { text-align: center; color: var(--c-text-2); padding: 32rpx 0; font-size: 26rpx; }
.wrap { display: flex; flex-wrap: wrap; } .wrap .chip { margin-bottom: 16rpx; }
.section-t { margin: 32rpx 0 16rpx; }
.about-link { text-align: center; color: var(--c-text-3); font-size: var(--fs-caption); padding: 32rpx 0 48rpx; }
.lib-wrap { display: flex; align-items: stretch; margin: 0 -32rpx; overflow: hidden; }
.side { width: 132rpx; flex-shrink: 0; background: var(--c-bg-2); }
.side-i { min-height: 96rpx; height: 96rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 26rpx; color: var(--c-text-2); border-left: 6rpx solid transparent; box-sizing: border-box; }
.side-i.on { background: var(--c-white); color: var(--c-ink); font-weight: 600; border-left-color: var(--c-accent); }
.side-n { font-size: 20rpx; color: var(--c-text-3); font-weight: 400; }
.main { flex: 1; min-width: 0; padding: 0 24rpx 0 16rpx; box-sizing: border-box; }
.main .group-title { margin: 0 -24rpx 0 -16rpx; padding: 0 16rpx; }
.sep { margin: 0 16rpx; }
.add-btn { width: 48rpx; height: 48rpx; border-radius: 50%; background: rgba(255,255,255,.92); color: var(--c-ink); font-size: 34rpx; line-height: 1; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 1px var(--c-line); }
.ex-badge { position: absolute; left: 10rpx; top: 10rpx; height: 34rpx; line-height: 34rpx; padding: 0 10rpx; border-radius: var(--r-tag); background: var(--c-accent); color: var(--c-white); font-size: 20rpx; font-weight: 600; }
