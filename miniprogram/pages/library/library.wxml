<nav-bar mode="tab" title="动作库">
  <view slot="right" class="nav-right">
    <text class="cap">{{total===all?'共 '+all+' 个':'共 '+total+' / '+all}}</text>
    <text wx:if="{{!readOnly}}" class="cap accent hit custom-entry" bindtap="goCustom">+ 自定义</text>
  </view>
</nav-bar>
<view class="page page-lib">
  <view class="lib-top">
    <view class="search"><view class="mag"></view><input value="{{q}}" placeholder="搜索中文 / 英文名" confirm-type="search" bindinput="onQ"/><view wx:if="{{q}}" class="clear" bindtap="clearQ"><view class="x"></view></view></view>
    <view class="row chips">
      <view class="chip {{equipment?'on':''}}" bindtap="openPanel">器械：{{eqLabel}} ▾</view>
      <text wx:if="{{q||bodyPart||equipment||group}}" class="sub hit" style="margin-left:auto;padding-left:16rpx" bindtap="clearAll">清除</text>
    </view>
  </view>
  <view class="lib-wrap" style="height:{{listH}}px">
    <scroll-view scroll-y class="side" style="height:{{listH}}px" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view wx:for="{{tabs}}" wx:key="key" class="side-i {{group===item.key?'on':''}}" bindtap="setGroup" data-k="{{item.key}}"><text>{{item.zh}}</text><text class="side-n">{{item.count}}</text></view>
    </scroll-view>
    <scroll-view scroll-y class="main" style="height:{{listH}}px" scroll-top="{{mainScrollTop}}" bindscrolltolower="more" lower-threshold="120" enhanced="{{true}}">
      <empty-state wx:if="{{!total}}" title="没有找到{{q?'“'+q+'”':'动作'}}" sub="试试其他关键词，或清除筛选 / 新建自定义" action="{{readOnly?'':'新建自定义'}}" bind:action="goCustom"></empty-state>
      <block wx:for="{{groups}}" wx:for-item="g" wx:key="key">
        <view class="group-title">{{g.title}}</view>
        <view class="ex-grid">
          <view wx:for="{{g.items}}" wx:key="id" class="ex-cell" bindtap="open" data-id="{{item.id}}">
            <view class="ex-img">
              <image wx:if="{{item.img}}" src="{{item.img}}" mode="aspectFill" lazy-load="{{true}}"/>
              <view wx:else class="ex-ph"><view class="db"><view class="db-p"></view><view class="db-p s"></view><view class="db-b"></view><view class="db-p s"></view><view class="db-p"></view></view><text class="ex-ini">{{item.initial}}</text></view>
              <view wx:if="{{item.hasVideo}}" class="ex-play"></view>
              <text wx:if="{{item.custom}}" class="ex-badge">自定</text>
            </view>
            <view wx:if="{{!readOnly}}" class="ex-corner add-btn" catchtap="quickAdd" data-id="{{item.id}}">+</view>
            <view class="ex-body">
              <view class="ex-nm">{{item.nameZh}}</view>
              <view class="ex-tags"><text class="tag tag-gray">{{item.part}}</text><text class="tag tag-gray">{{item.equip}}</text></view>
            </view>
          </view>
        </view>
      </block>
      <view wx:if="{{shown < total}}" class="more" bindtap="more">加载更多（已显示 {{shown}} / {{total}}）</view>
      <view class="about-link"><text bindtap="openSettings">设置</text><text class="sep">·</text><text bindtap="openAbout">关于 / 数据来源</text></view>
    </scroll-view>
  </view>
</view>
<block wx:if="{{panel}}">
  <view class="mask" bindtap="closePanel"></view>
  <view class="sheet">
    <view class="row between"><text class="h2">筛选</text><text class="sub hit" bindtap="panelReset">重置</text></view>
    <view class="cap section-t">器械</view>
    <view class="wrap"><view class="chip {{!panelEq?'on':''}}" bindtap="pEq" data-v="">不限</view><view wx:for="{{equipments}}" wx:key="value" class="chip {{panelEq===item.value?'on':''}}" bindtap="pEq" data-v="{{item.value}}">{{item.zh}}</view></view>
    <view style="margin-top:32rpx"><btn bind:press="applyPanel" disabled="{{!panelCount}}">查看 {{panelCount}} 个动作</btn></view>
  </view>
</block>
