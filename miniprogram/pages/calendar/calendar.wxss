page { background: #F6F3EE; }
.tab-title { font-size: 64rpx; font-weight: 700; color: #121212; }
.cal-pad { padding-bottom: 32rpx; }
.ruled {
  padding-bottom: 280rpx;
  background-image: linear-gradient(rgba(44, 36, 30, 0.07) 1px, transparent 1px);
  background-size: 100% 56rpx;
  background-repeat: repeat-y;
  background-position: 0 56rpx;
}
.day-in { animation: day-in 160ms ease both; }
@keyframes day-in { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: none; } }
.day-head { margin-top: 20rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; }
.share-hit { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.share-box { width: 36rpx; height: 30rpx; border: 3rpx solid #5C5854; border-radius: 6rpx; position: relative; }
.share-box::before { content: ''; position: absolute; left: 16rpx; top: -16rpx; width: 3rpx; height: 20rpx; background: #5C5854; }
.share-box::after { content: ''; position: absolute; left: 10rpx; top: -14rpx; width: 14rpx; height: 14rpx; border-left: 3rpx solid #5C5854; border-top: 3rpx solid #5C5854; transform: rotate(45deg); box-sizing: border-box; }
.day-title { font-family: "Songti SC", "Noto Serif CJK SC", serif; font-size: 40rpx; font-weight: 600; color: #2C241E; }
.peer { margin-top: 16rpx; background: #FFFEFB; border-radius: 32rpx; padding: 28rpx 32rpx; border: 1px solid rgba(44, 36, 30, 0.04); box-shadow: 0 4rpx 20rpx rgba(44, 36, 30, 0.07), 0 2rpx 4rpx rgba(44, 36, 30, 0.05); box-sizing: border-box; }
.tilt-train { transform: rotate(-0.4deg); transform-origin: center center; }
.tilt-diet { transform: rotate(0.35deg); transform-origin: center center; margin-top: 24rpx; }
.peer-top { display: flex; align-items: baseline; min-height: 44rpx; }
.peer-k { font-size: 32rpx; font-weight: 700; color: #121212; }
.peer-meta { margin-left: 16rpx; flex: 1; font-size: 26rpx; font-weight: 500; color: #6B6560; }
.peer-meta.pop { animation: meta-pop 200ms ease; }
@keyframes meta-pop { 0% { transform: scale(1); } 50% { transform: scale(1.12); } 100% { transform: scale(1); } }
.peer-note { margin-top: 8rpx; font-size: 22rpx; color: #6B6560; }
.peer-links { margin-top: 12rpx; display: flex; align-items: center; }
.tpl { margin-left: auto; font-size: 26rpx; font-weight: 600; color: #C64B19; padding: 8rpx 0 8rpx 16rpx; }
.empty-slot { height: 104rpx; margin-top: 20rpx; border: 3rpx dashed #D9D1C6; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; color: #A89F94; font-size: 26rpx; }
.entry { display: flex; align-items: center; min-height: 128rpx; padding: 8rpx 0; }
.entry + .entry { border-top: 1px dashed rgba(44, 36, 30, 0.08); }
.sticker { width: 140rpx; height: 140rpx; flex-shrink: 0; }
.sticker.lg { width: 168rpx; height: 168rpx; }
.sticker.l { transform: rotate(-7deg); }
.sticker.r { transform: rotate(6deg); }
.sticker.land.l { animation: land-l 300ms cubic-bezier(.34, 1.56, .64, 1) both; }
.sticker.land.r { animation: land-r 300ms cubic-bezier(.34, 1.56, .64, 1) both; }
@keyframes land-l { from { transform: scale(1.15) rotate(-12deg); opacity: 0; } to { transform: scale(1) rotate(-7deg); opacity: 1; } }
@keyframes land-r { from { transform: scale(1.15) rotate(-12deg); opacity: 0; } to { transform: scale(1) rotate(6deg); opacity: 1; } }
@media (prefers-reduced-motion: reduce) {
  .sticker.land.l, .sticker.land.r, .day-in, .peer-meta.pop { animation: fade-only 300ms linear both; }
}
@keyframes fade-only { from { opacity: 0; } to { opacity: 1; } }
.entry-text { flex: 1; min-width: 0; margin-left: 24rpx; }
.entry-name { display: block; font-family: "Songti SC", "Noto Serif CJK SC", serif; font-size: 32rpx; font-weight: 600; color: #2C241E; }
.entry-sub { display: block; margin-top: 4rpx; font-size: 24rpx; color: #6B6560; }
.entry-kcal { font-family: "Songti SC", "Noto Serif CJK SC", serif; font-size: 28rpx; font-weight: 600; color: #2C241E; margin-left: 12rpx; }
.empty-hint { margin-top: 32rpx; text-align: center; font-size: 26rpx; line-height: 1.4; color: #6B6560; }
.cal-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(44, 36, 30, .4); z-index: 60; display: flex; align-items: flex-end; }
.cal-panel { width: 100%; background: #FFFEFB; border-radius: 40rpx 40rpx 0 0; padding: 16rpx 8rpx 0; box-sizing: border-box; }
.cal-sheet-title { font-size: 26rpx; line-height: 40rpx; color: #6B6560; padding: 4rpx 8rpx 8rpx; }
.cal-row { height: 104rpx; display: flex; align-items: center; padding: 0 8rpx; font-size: 34rpx; color: #121212; }
.cal-trail { margin-left: auto; color: #6B6560; font-size: 34rpx; }
.cal-cancel { height: 104rpx; margin-top: 8rpx; display: flex; align-items: center; justify-content: center; color: #6B6560; font-size: 32rpx; border-top: 1px solid rgba(44, 36, 30, 0.08); padding-bottom: env(safe-area-inset-bottom); }
.ico { width: 48rpx; height: 48rpx; margin-right: 24rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.plate { width: 10rpx; height: 28rpx; border: 3rpx solid #121212; border-radius: 4rpx; box-sizing: border-box; }
.bar { width: 16rpx; height: 4rpx; margin: 0 2rpx; background: #121212; }
.bowl { width: 36rpx; height: 18rpx; margin-top: 8rpx; border: 3rpx solid #121212; border-top: none; border-radius: 0 0 20rpx 20rpx; box-sizing: border-box; }
.pulse { width: 36rpx; height: 22rpx; border-bottom: 3rpx solid #121212; position: relative; box-sizing: border-box; }
.pulse::before { content: ''; position: absolute; left: 10rpx; bottom: -3rpx; width: 14rpx; height: 22rpx; border-left: 3rpx solid #121212; border-right: 3rpx solid #121212; transform: skewX(-18deg); box-sizing: border-box; }
.doc { width: 26rpx; height: 32rpx; border: 3rpx solid #121212; border-radius: 4rpx; box-sizing: border-box; position: relative; }
.doc::before { content: ''; position: absolute; left: 4rpx; right: 4rpx; top: 8rpx; height: 3rpx; background: #121212; box-shadow: 0 8rpx 0 #121212; }
.rest { width: 28rpx; height: 28rpx; border: 3rpx solid #121212; border-radius: 50%; border-right-color: transparent; transform: rotate(-40deg); box-sizing: border-box; }
.link { margin-right: 24rpx; font-size: 26rpx; color: #3A3A3A; text-decoration: underline; padding: 8rpx 0; }
.tag-rest { background: #EEF2F7; color: #6B7F99; }
.tag-aero { background: #FFE4D6; color: #C94412; }
.ell { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 16rpx; }
.rec-title { margin-top: 36rpx; font-size: 26rpx; color: #5F5F5F; }
.rec { margin-top: 16rpx; }
.diet-rec { background: #fff; border-radius: 24rpx; padding: 28rpx 32rpx; display: flex; align-items: center; min-height: 112rpx; box-sizing: border-box; }
.diet-rec .rec-name { margin-left: 12rpx; }
.diet-rec .sub { margin-left: 16rpx; }
.rec-name { font-size: 30rpx; font-weight: 600; }
.rec-meta { padding-top: 12rpx; }
.ex-line { padding-top: 12rpx; font-size: 28rpx; }
.tabbar-keep { position: fixed; left: -480rpx; top: -480rpx; width: 1px; height: 1px; overflow: hidden; opacity: 0; pointer-events: none; z-index: -1; }
.tabbar-keep image { width: 1px; height: 1px; }
.fab.cal-fab { background: #FC5B21; right: 40rpx; bottom: 28rpx; box-shadow: 0 12rpx 32rpx rgba(252, 91, 33, 0.35); }
