<nav-bar mode="tab" title="日历" tone="warm"></nav-bar>
<view class="page page-pad-tab cal-pad">
  <month-calendar year="{{year}}" month="{{month}}" selected="{{selected}}" today="{{today}}" marks="{{marks}}" info="{{info}}" cals="{{cals}}" view="{{calView}}" rich legend collapsible bind:select="onSelect" bind:shift="onShift" bind:today="onToday" bind:toggle="onToggle"></month-calendar>

  <view wx:if="{{draft}}" class="banner"><text class="sub" style="color:var(--c-ink)">{{draft.text}}</text><text class="accent hit" style="font-weight:600;padding-left:24rpx" bindtap="continueDraft">继续</text></view>

  <view class="ruled {{dayAnim ? 'day-in' : ''}}">
  <view class="day-head"><text class="day-title">{{sel.label}}</text></view>

  <view class="peer tilt-train">
    <view class="peer-top">
      <text class="peer-k">训练</text>
      <text class="peer-meta {{trainPop ? 'pop' : ''}}">{{train.head}}</text>
      <text wx:if="{{!train.future}}" class="tpl" catchtap="openTemplates">模板 ›</text>
    </view>
    <view wx:if="{{train.note}}" class="peer-note">{{train.note}}</view>
    <view wx:for="{{trainRows}}" wx:key="id" class="entry" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="openCard">
      <image class="sticker {{item.rot}} {{item.fresh ? 'land' : ''}}" src="{{item.sticker}}" mode="aspectFit" />
      <view class="entry-text">
        <text class="entry-name">{{item.name}}</text>
        <text wx:if="{{item.sub}}" class="entry-sub">{{item.sub}}</text>
      </view>
    </view>
    <view wx:if="{{!trainRows.length && sel.kind !== 'future'}}" class="empty-slot">训练会像贴纸一样贴在这里</view>
    <view wx:if="{{sel.isRest && !readOnly}}" class="peer-links">
      <text class="link" catchtap="unmarkRest">取消休息日</text>
      <text class="link" catchtap="pickTrain">补录训练</text>
    </view>
  </view>

  <view class="peer tilt-diet" bindtap="openDietDay">
    <view class="peer-top">
      <text class="peer-k">饮食</text>
      <text class="peer-meta {{dietPop ? 'pop' : ''}}">{{diet.head}}</text>
    </view>
    <view wx:for="{{dietRows}}" wx:key="id" class="entry" catchtap="openDietDay">
      <image class="sticker {{item.lg ? 'lg' : ''}} {{item.rot}} {{item.fresh ? 'land' : ''}}" src="{{item.sticker}}" mode="aspectFit" />
      <view class="entry-text">
        <text class="entry-name">{{item.name}}</text>
        <text wx:if="{{item.sub}}" class="entry-sub">{{item.sub}}</text>
      </view>
      <text class="entry-kcal">{{item.kcal}}</text>
    </view>
    <view wx:if="{{!dietRows.length && sel.kind !== 'future'}}" class="empty-slot">记一餐，贴一张专属贴纸</view>
  </view>
  <view wx:if="{{!listCount && sel.kind !== 'future'}}" class="empty-hint">点右下角 +，记训练或饮食</view>
  </view>
</view>
<view class="fab cal-fab {{sel.kind==='future'||readOnly?'disabled':''}}" bindtap="pickAdd">+</view>
<view wx:if="{{sheet}}" class="cal-mask" bindtap="closeSheet">
  <view class="cal-panel" catchtap="stop">
    <view class="cal-sheet-title">{{sheet.title}}</view>
    <view wx:for="{{sheet.rows}}" wx:key="key" class="cal-row" data-key="{{item.key}}" bindtap="onSheet">
      <view class="ico">
        <block wx:if="{{item.icon==='lift'}}"><view class="plate"></view><view class="bar"></view><view class="plate"></view></block>
        <view wx:elif="{{item.icon==='bowl'}}" class="bowl"></view>
        <view wx:elif="{{item.icon==='pulse'}}" class="pulse"></view>
        <view wx:elif="{{item.icon==='doc'}}" class="doc"></view>
        <view wx:elif="{{item.icon==='rest'}}" class="rest"></view>
      </view>
      <text class="cal-label">{{item.label}}</text>
      <text wx:if="{{item.trail}}" class="cal-trail">{{item.trail}}</text>
    </view>
    <view class="cal-cancel" bindtap="closeSheet">取消</view>
  </view>
</view>
<!-- 底部 tab 图标。过滤无依赖文件不把 app.json 的 iconPath 当依赖，这里显式引用，避免编译时被丢掉。 -->
<view class="tabbar-keep">
  <image src="/images/tabbar/calendar.png" />
  <image src="/images/tabbar/calendar-active.png" />
  <image src="/images/tabbar/library.png" />
  <image src="/images/tabbar/library-active.png" />
  <image src="/images/tabbar/diet.png" />
  <image src="/images/tabbar/diet-active.png" />
  <image src="/images/tabbar/body.png" />
  <image src="/images/tabbar/body-active.png" />
</view>
