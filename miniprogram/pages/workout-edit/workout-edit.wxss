.nav-date { font-size: var(--fs-nav); font-weight: 600; }
.status-line { padding: 8rpx 0 16rpx; }
.ex-card { border: 1px solid var(--c-line); border-radius: var(--r-card); padding: 0 24rpx; margin-top: 24rpx; }
.ex-head { height: 112rpx; }
.ex-name { font-size: 34rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 380rpx; }
.dots { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; color: var(--c-text-2); margin-right: -16rpx; }
.ex-note { margin-top: -16rpx; padding-bottom: 8rpx; }
.th { height: 48rpx; }
.add-set { height: 96rpx; display: flex; align-items: center; font-weight: 600; }
.sort-row { height: 112rpx; border: 1px solid var(--c-line); border-radius: var(--r-card); padding: 0 8rpx 0 24rpx; margin-top: 16rpx; }
.mv { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; }
.mv.off { color: var(--c-placeholder); }
.discard { text-align: center; color: var(--c-danger); padding: 32rpx 0; font-size: 28rpx; }

.c-no { width: 72rpx; text-align: center; flex-shrink: 0; }
.c-w { width: 240rpx; margin-left: 8rpx; text-align: center; flex-shrink: 0; }
.c-r { width: 200rpx; margin-left: 8rpx; text-align: center; flex-shrink: 0; }
.c-chk { width: 88rpx; margin-left: 8rpx; text-align: center; flex-shrink: 0; }
.ell1 { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.save-st { flex-shrink: 0; padding: 16rpx 0 16rpx 16rpx; }
.nav-date { white-space: nowrap; }
.hint { margin-top: -16rpx; padding-bottom: 16rpx; }
.rest-lnk { padding: 24rpx 0 24rpx 24rpx; }
