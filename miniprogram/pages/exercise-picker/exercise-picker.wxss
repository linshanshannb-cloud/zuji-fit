.page-pk { padding-bottom: 0; overflow: hidden; }
.pk-top { padding-bottom: 8rpx; }
.nm { font-size: 32rpx; font-weight: 600; }
.pick { width: 48rpx; height: 48rpx; border-radius: 50%; border: 3rpx solid var(--c-check); box-sizing: border-box; display: flex; align-items: center; justify-content: center; color: var(--c-white); font-size: 24rpx; font-weight: 700; }
.pick.on { background: var(--c-accent); border-color: var(--c-accent); }
.more { text-align: center; color: var(--c-text-2); padding: 32rpx 0; font-size: 26rpx; }
.pk-wrap { display: flex; align-items: stretch; margin: 0 -32rpx; overflow: hidden; }
.side { width: 132rpx; flex-shrink: 0; background: var(--c-bg-2); }
.side-i { min-height: 96rpx; height: 96rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 26rpx; color: var(--c-text-2); border-left: 6rpx solid transparent; box-sizing: border-box; }
.side-i.on { background: var(--c-white); color: var(--c-ink); font-weight: 600; border-left-color: var(--c-accent); }
.side-n { font-size: 20rpx; color: var(--c-text-3); font-weight: 400; }
.main { flex: 1; min-width: 0; padding: 0 24rpx 0 16rpx; box-sizing: border-box; }
.main .flex1 { min-width: 0; } .main .nm { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; max-width: 300rpx; }
.ex-corner.pick { background: rgba(255,255,255,.92); }
.ex-cell.sel { border-color: var(--c-accent); }
.added { position: absolute; left: 10rpx; top: 10rpx; height: 34rpx; font-size: 20rpx; }
.ex-badge { position: absolute; left: 10rpx; top: 10rpx; height: 34rpx; line-height: 34rpx; padding: 0 10rpx; border-radius: var(--r-tag); background: var(--c-accent); color: var(--c-white); font-size: 20rpx; font-weight: 600; z-index: 1; }
.ex-badge + .added { top: 50rpx; }
.det { flex-shrink: 0; padding: 8rpx 0 8rpx 8rpx; margin-top: 8rpx; }
