<nav-bar title="饮食回顾"></nav-bar>
<view class="page">
  <empty-state wx:if="{{!review||review.empty}}" title="还没有可以回顾的目标" action="去设置目标" bind:action="openGoal"></empty-state>
  <block wx:else>
    <view class="h2">体重</view>
    <view class="cap">用的是身体数据里的体重，不是饮食目标锁住的参考体重。</view>
    <view wx:if="{{review.chart}}" class="block"><line-chart series="{{review.chart}}" unit="kg" height="{{360}}"></line-chart></view>
    <view wx:else class="note">{{review.sample}}</view>
    <view class="block"><card>
      <view class="cap">锁定的参考体重</view>
      <view class="macro-n num">{{review.locked}}<text class="unit">kg</text></view>
      <view class="cap" style="margin-top:8rpx">身体数据最新 {{review.latest}}</view>
      <view wx:if="{{review.drift}}" class="cap">两边不一样。每日目标仍按锁定体重，直到你在下面确认。</view>
    </card></view>
    <view class="stack"><btn type="secondary" disabled="{{readOnly}}" bind:press="openWeight">更新参考体重</btn></view>
    <view wx:if="{{review.observe}}" class="note">{{review.observe}}</view>
    <view class="note">{{review.sumText}}</view>
    <view wx:if="{{review.noLog}}" class="note">{{review.noLogText}}</view>
    <view wx:if="{{review.floorText}}" class="cap" style="margin-top:16rpx">{{review.floorText}}</view>
    <view wx:if="{{review.declineText}}" class="note">{{review.declineText}}</view>
    <view class="stack"><btn disabled="{{readOnly}}" bind:press="openAdjust" data-kind="{{review.mode==='cycle'?'manual':'stuck'}}">{{review.mode==='cycle'?'调整三日克数':'查看降碳建议'}}</btn></view>
    <view class="stack"><btn type="secondary" disabled="{{readOnly}}" bind:press="openAdjust" data-kind="strength">力量下滑，建议加碳</btn></view>
    <view class="cap" style="margin-top:12rpx">{{review.mode==='cycle'?'确认前不会改任何一天的目标。':'卡住时的默认建议是碳水 −15 g，也可以选 −20 / −30，或按米饭份量。不点确认，目标不变。'}}</view>
    <view class="stack h2">阶段</view>
    <view wx:for="{{review.stages}}" wx:key="id" class="li-2 hairline-b">
      <view class="flex1">
        <view>{{item.title}}<text wx:if="{{item.current}}" class="tag tag-solid">当前</text></view>
        <view class="cap">{{item.sub}}</view>
        <view class="cap">{{item.weight}}</view>
      </view>
    </view>
  </block>
</view>

<view wx:if="{{sheet}}" class="mask" bindtap="closeSheet"></view>
<view wx:if="{{sheet==='adjust'}}" class="sheet" catchtap="noop">
  <view class="h2">{{adjust.kind==='strength'?'力量下滑的建议':'调整建议'}}</view>
  <view class="sub">{{adjust.note}}</view>
  <view wx:if="{{adjust.windowNote}}" class="cap" style="margin-top:8rpx">{{adjust.windowNote}}</view>
  <view wx:if="{{adjust.trend}}" class="cap" style="margin-top:8rpx">{{adjust.trend}}</view>
  <view wx:if="{{adjust.floorNote}}" class="note">{{adjust.floorNote}}</view>
  <block wx:if="{{adjust.mode==='taper'}}">
    <view class="row choice">
      <view wx:for="{{stuckChoices}}" wx:key="*this" class="chip" bindtap="setChip" data-d="{{item}}">{{item}} g</view>
      <view class="chip" bindtap="setChip" data-d="15">+15 g</view>
    </view>
    <view class="field hairline-b"><text class="field-label lab">碳水</text><input class="field-input num" type="digit" data-k="carbsG" value="{{adjust.carbsG}}" bindinput="onAdjust"/><text class="field-unit">g</text></view>
    <view class="field hairline-b"><text class="field-label lab">蛋白</text><input class="field-input num" type="digit" data-k="proteinG" value="{{adjust.proteinG}}" bindinput="onAdjust"/><text class="field-unit">g</text></view>
    <view class="field hairline-b"><text class="field-label lab">脂肪</text><input class="field-input num" type="digit" data-k="fatG" value="{{adjust.fatG}}" bindinput="onAdjust"/><text class="field-unit">g</text></view>
    <view class="cap">按米饭减碳时，必须先选生重或熟重。口播例每 100 g 约 25 g 碳，生熟系数相同，但口径会记下来。</view>
    <view class="row choice">
      <view class="chip {{adjust.basis==='raw'?'on':''}}" bindtap="setAdjustBasis" data-m="raw">生重</view>
      <view class="chip {{adjust.basis==='cooked'?'on':''}}" bindtap="setAdjustBasis" data-m="cooked">熟重</view>
    </view>
    <view class="field hairline-b"><text class="field-label lab">米饭</text><input class="field-input num" type="digit" data-k="rice" value="{{adjust.rice}}" bindinput="onAdjust"/><text class="field-unit">g</text></view>
    <view class="stack"><btn type="secondary" bind:press="applyRice">按这份米饭填碳水</btn></view>
    <view wx:if="{{adjust.riceNote}}" class="cap">{{adjust.riceNote}}</view>
  </block>
  <block wx:else>
    <view wx:for="{{adjust.days}}" wx:key="type">
      <view class="h2" style="margin-top:16rpx">{{item.label}}碳</view>
      <view class="field hairline-b"><text class="field-label lab">碳水</text><input class="field-input num" type="digit" data-i="{{index}}" data-k="carbsG" value="{{item.carbsG}}" bindinput="onAdjustDay"/><text class="field-unit">g</text></view>
      <view class="field hairline-b"><text class="field-label lab">蛋白</text><input class="field-input num" type="digit" data-i="{{index}}" data-k="proteinG" value="{{item.proteinG}}" bindinput="onAdjustDay"/><text class="field-unit">g</text></view>
      <view class="field hairline-b"><text class="field-label lab">脂肪</text><input class="field-input num" type="digit" data-i="{{index}}" data-k="fatG" value="{{item.fatG}}" bindinput="onAdjustDay"/><text class="field-unit">g</text></view>
    </view>
  </block>
  <view class="stack"><btn disabled="{{readOnly}}" bind:press="confirmAdjust">确认新阶段</btn></view>
</view>
<view wx:if="{{sheet==='weight'}}" class="sheet" catchtap="noop">
  <view class="h2">更新参考体重</view>
  <view class="cap">当前锁定 {{weightForm.locked}} kg。改完并确认后，从今天起按新体重重算。更早的日期不变。</view>
  <view class="field hairline-b"><text class="field-label lab">新体重</text><input class="field-input num" type="digit" value="{{weightForm.refWeightKg}}" bindinput="onWeight"/><text class="field-unit">kg</text></view>
  <view class="sub hit" bindtap="toggleKeep">{{weightForm.keepGrams?'克数保持不变（已选）':'克数按原系数重算（点此改为保持克数）'}}</view>
  <view wx:if="{{weightForm.error}}" class="err-text">{{weightForm.error}}</view>
  <block wx:elif="{{weightForm.preview&&weightForm.preview.mode==='taper'}}">
    <view class="sub">碳 {{weightForm.preview.c}} · 蛋白 {{weightForm.preview.p}} · 脂 {{weightForm.preview.f}} g · {{weightForm.preview.k}} kcal</view>
  </block>
  <block wx:elif="{{weightForm.preview&&weightForm.preview.mode==='cycle'}}">
    <view wx:for="{{weightForm.preview.days}}" wx:key="type" class="cap">{{item.label}} 碳 {{item.c}} · 蛋白 {{item.p}} · 脂 {{item.f}} · {{item.k}} kcal</view>
  </block>
  <view class="stack"><btn disabled="{{readOnly}}" bind:press="confirmWeight">确认更新</btn></view>
</view>
