<nav-bar title="{{title}}" tone="warm"></nav-bar>
<view class="page day">
  <view class="date">{{dateTitle}}</view>
  <view wx:if="{{entries.length}}" class="sum">
    <text class="kcal num">{{kcalLine}}</text>
    <text class="sub">{{sub}}</text>
  </view>
  <view wx:if="{{!entries.length}}" class="empty">{{future ? '还没到这一天' : '还没记饮食'}}</view>
  <view wx:for="{{entries}}" wx:key="id" class="item" bindtap="openMeal" data-meal="{{item.meal}}">
    <view class="row between">
      <text class="name">{{item.displayName}}</text>
      <view class="row">
        <text class="num kcal-sm">{{item.kcal}} kcal</text>
        <text class="go">›</text>
      </view>
    </view>
    <view class="meta">{{item.mealLabel}}<text wx:if="{{item.eatenAt}}"> · {{item.eatenAt}}</text><text wx:if="{{item.portion}}"> · {{item.portion}}</text><text wx:if="{{item.source==='ai-text'}}"> · 估算</text></view>
    <view class="meta">{{item.macro}}</view>
    <view wx:if="{{item.extra}}" class="meta">{{item.extra}}</view>
    <view wx:if="{{item.note}}" class="note">{{item.note}}</view>
    <view wx:if="{{item.tips}}" class="tip">{{item.tips}}</view>
  </view>
</view>
<view wx:if="{{canAdd}}" class="addbar">
  <view class="add-main" bindtap="openAi">文字识别</view>
  <view class="add-sub" bindtap="openLog">手动录入</view>
</view>
