page { background: #F6F3EE; }
.day { padding-bottom: 280rpx; }
.date { margin-top: 8rpx; font-size: 26rpx; color: #5F5F5F; }
.sum { margin-top: 16rpx; background: #fff; border-radius: 24rpx; padding: 28rpx 32rpx; display: flex; align-items: baseline; }
.kcal { font-size: 48rpx; font-weight: 700; line-height: 1.15; color: #111111; }
.sum .sub { margin-left: 16rpx; color: #5F5F5F; }
.empty { margin-top: 48rpx; font-size: 32rpx; color: #5F5F5F; }
.item { margin-top: 16rpx; background: #fff; border-radius: 24rpx; padding: 28rpx 32rpx; }
.name { font-size: 32rpx; font-weight: 600; }
.kcal-sm { font-weight: 600; }
.go { margin-left: 8rpx; font-size: 36rpx; color: #6B6B6B; }
.meta { margin-top: 6rpx; font-size: 26rpx; color: #5F5F5F; }
.note { margin-top: 8rpx; font-size: 26rpx; color: #5D4E44; }
.tip { margin-top: 8rpx; font-size: 26rpx; color: #5F5F5F; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.addbar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 6;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #F6F3EE;
}
.add-main, .add-sub {
  height: 96rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 600;
}
.add-main { background: #1A1A1A; color: #fff; }
.add-sub { height: 88rpx; margin-top: 24rpx; background: #fff; color: #1A1A1A; border: 2rpx solid #1A1A1A; }
