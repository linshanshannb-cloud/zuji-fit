.sum { margin-top: 16rpx; background: var(--c-bg-2); border-radius: var(--r-card); padding: 32rpx; display: flex; align-items: baseline; }
.kcal { font-size: 48rpx; font-weight: 700; line-height: 1.15; }
.sum .sub { margin-left: 16rpx; }
.empty { margin-top: 24rpx; color: var(--c-text-2); font-size: 30rpx; }
.item { margin-top: 16rpx; background: var(--c-bg-2); border-radius: var(--r-card); padding: 28rpx 32rpx; }
.name { font-size: 32rpx; font-weight: 600; }
.note { display: block; margin-top: 8rpx; }
.stack { margin-top: 24rpx; }
