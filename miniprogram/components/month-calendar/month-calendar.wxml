<view class="head row between">
  <view class="row">
    <text class="ym">{{year}}年{{month}}月</text>
    <view wx:if="{{selected !== today}}" class="today-hit" bindtap="goToday"><text class="today-pill">今天</text></view>
    <view wx:if="{{collapsible}}" class="toggle hit" bindtap="onToggle"><text>{{view==='week'?'展开月历':'收起'}}</text><view class="fold-chev {{view==='week'?'':'up'}}"></view></view>
  </view>
  <view class="row"><view class="arrow" aria-label="{{view==='week'?'上一周':'上一月'}}" bindtap="prev"><view class="nav-chev prev"></view></view><view class="arrow" aria-label="{{view==='week'?'下一周':'下一月'}}" bindtap="next"><view class="nav-chev next"></view></view></view>
</view>
<view class="week"><view wx:for="{{weekdays}}" wx:key="*this" class="wd">{{item}}</view></view>
<view class="grid" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <view wx:for="{{rows}}" wx:for-item="row" wx:key="key" class="cal-row {{row.open ? 'open' : 'shut'}}">
  <view wx:for="{{row.cells}}" wx:key="date" class="cell v-{{variant}} {{rich&&variant==='dot'?'rich':''}} {{view==='week'&&rich?'is-week':''}} {{item.inMonth?'':'out'}} {{item.future?'future':''}} {{item.train?'train':''}} {{item.isToday?'today':''}} {{item.sel?'sel':''}}" bindtap="onPick" data-date="{{item.date}}">
    <view class="n num">{{item.day}}</view>
    <view wx:if="{{view==='week' && rich && row.open && item.dot}}" class="jdot jdot-{{item.dot}}"></view>
    <block wx:elif="{{variant==='dot' && rich && row.open}}">
      <view wx:if="{{item.brief}}" class="markline {{item.rest ? 'is-rest' : ''}} {{item.aero && !item.part ? 'is-aero' : ''}}">{{item.brief}}</view>
      <view wx:elif="{{item.showDot}}" class="dot on"></view>
      <view wx:else class="markline"></view>
      <view class="ckcal num">{{item.kcal}}</view>
    </block>
    <block wx:elif="{{variant==='dot' && !rich}}">
      <view wx:if="{{item.part}}" class="ctag ctag-part">{{item.part}}</view>
      <view wx:if="{{item.aero}}" class="ctag ctag-aero">{{item.aero}}</view>
      <view wx:if="{{item.rest}}" class="ci ci-r">休</view>
      <view wx:elif="{{item.showDot}}" class="dot on"></view>
      <view wx:if="{{item.kcal}}" class="ckcal num">{{item.kcal}}</view>
    </block>
    <view wx:elif="{{variant!=='dot'}}" class="val num">{{item.mark}}</view>
  </view>
  </view>
</view>
<view wx:if="{{legend && hasMarks && view!=='week'}}" class="foot row between">
  <view class="legend row"><view class="lg-box"><view class="ctag ctag-part">胸</view></view><text>力量</text><view class="lg-box"><view class="ctag ctag-aero">有氧</view></view><text>有氧</text><block wx:if="{{rich}}"><view class="lg-rest">休</view><text>休息</text></block><view class="lg-sel"></view><text>选中</text></view>
</view>
<view wx:if="{{legend && hasKcal && view!=='week'}}" class="lg-note">数字为当日饮食热量</view>
