.head { height: 88rpx; }
.ym { font-size: 32rpx; font-weight: 500; color: #2C241E; }
.today-pill { display: inline-flex; align-items: center; height: 56rpx; padding: 0 22rpx; border: 1px solid #D9D3CC; border-radius: var(--r-pill); color: #121212; font-size: 26rpx; background: #fff; box-sizing: border-box; }
.arrow { width: 88rpx; height: 88rpx; margin-left: -32rpx; display: flex; align-items: center; justify-content: center; }
.arrow:first-child { margin-left: 0; }
.nav-chev { width: 36rpx; height: 36rpx; border-top: 3rpx solid #5C5854; border-right: 3rpx solid #5C5854; box-sizing: border-box; }
.nav-chev.prev { transform: rotate(-135deg); }
.nav-chev.next { transform: rotate(45deg); }
.week { display: flex; flex-wrap: wrap; }
.grid { display: block; }
.cal-row { display: flex; width: 100%; }
.wd { width: 14.2857%; text-align: center; font-size: 24rpx; color: #6B6560; padding: 8rpx 0; }
.cell { width: 14.2857%; height: 88rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; }
.v-value { height: 100rpx; }
.n { width: 68rpx; height: 68rpx; line-height: 68rpx; border-radius: 50%; text-align: center; font-size: 30rpx; position: relative; color: #121212; }
.v-value .n { width: 60rpx; height: 60rpx; line-height: 60rpx; }
.future .n { color: #6B6560; }
.out .n { color: var(--c-placeholder); }
.dot { position: relative; width: 10rpx; height: 10rpx; border-radius: 50%; margin-top: 2rpx; }
.dot.on { background: var(--c-accent); }
.val { font-size: 18rpx; color: var(--c-text-3); height: 24rpx; line-height: 24rpx; }
.out .dot, .out .val { visibility: hidden; }
.today-hit { height: 88rpx; display: flex; align-items: center; padding: 0 16rpx; }
/* 日期、一行训练、底部热量。整行都没有标签或热量时不留第二行。 */
.rich { height: 132rpx; justify-content: flex-start; padding-top: 4rpx; box-sizing: border-box; }
.rich.is-week { height: 88rpx; padding-top: 0; justify-content: flex-start; }
.cal-row.shut .rich,
.cal-row.shut .rich.is-week { height: 64rpx; padding-top: 0; justify-content: center; }
.rich.is-week .n { width: 64rpx; height: 64rpx; line-height: 64rpx; font-size: 32rpx; font-weight: 600; }
.rich.is-week.future .n { font-weight: 500; }
.rich.is-week.train::before { display: none; }
.rich.is-week.sel .n { width: 64rpx; height: 64rpx; line-height: 64rpx; background: #FFE4D6; color: #C64B19; box-shadow: inset 0 0 0 3rpx #F0C4A8; }
.jdot { width: 10rpx; height: 10rpx; border-radius: 50%; margin-top: 6rpx; }
.jdot-train { background: #FC5B21; }
.jdot-diet { background: #7A6A58; }
.jdot-rest { background: #C4B8A8; }
.jdot-both { background: #FC5B21; box-shadow: 12rpx 0 0 #7A6A58; margin-right: 12rpx; }
.rich .n { width: 40rpx; height: 40rpx; line-height: 40rpx; font-size: 28rpx; }
/* 训练日：整格浅橙底 + 日期加粗 */
.rich.train::before { content: ''; position: absolute; top: 2rpx; bottom: 0; left: 3rpx; right: 3rpx; border-radius: 16rpx; background: #FFE4D6; }
.train .n { color: var(--c-ink); font-weight: 700; }
.out.train::before { display: none; }
.today .n { color: var(--c-accent); font-weight: 700; }
.sel .n { background: var(--c-ink); color: var(--c-white); font-weight: 700; }
.rich.sel .n { width: 60rpx; height: 60rpx; line-height: 60rpx; background: #FFE4D6; color: #C64B19; box-shadow: inset 0 0 0 1px #C64B19; }
/* 格子标签：力量在上（黑字）、有氧在下（深橙字），白底，20rpx */
.ctag { position: relative; max-width: 88rpx; margin-top: 2rpx; padding: 0 6rpx; box-sizing: border-box; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; text-align: center; font-size: 20rpx; line-height: 24rpx; height: 24rpx; border-radius: 6rpx; font-weight: 600; background: var(--c-white); }
.ctag-part { color: var(--c-ink); }
.ctag-aero { color: #C94412; }
.ci { position: relative; max-width: 100%; padding: 0 2rpx; box-sizing: border-box; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; text-align: center; font-size: 19rpx; line-height: 24rpx; height: 24rpx; }
.ci-r { color: #6B7F99; font-weight: 600; margin-top: 4rpx; width: 32rpx; height: 32rpx; line-height: 32rpx; border-radius: 50%; background: #EEF2F7; font-size: 20rpx; padding: 0; }
.out .ctag, .out .ci, .out .ckcal { visibility: hidden; }
.markline { position: relative; max-width: 96rpx; height: 28rpx; line-height: 28rpx; font-size: 20rpx; font-weight: 600; color: #5F5F5F; text-align: center; overflow: hidden; white-space: nowrap; }
.markline.is-aero { color: #C94412; }
.markline.is-rest { color: #6B7F99; }
.out .markline { visibility: hidden; }
.ckcal { position: relative; max-width: 96rpx; height: 24rpx; line-height: 24rpx; font-size: 20rpx; font-weight: 600; color: #5F5F5F; text-align: center; }
.rich.is-week .ckcal { height: 32rpx; line-height: 32rpx; font-size: 24rpx; }
.lg-note { font-size: 22rpx; line-height: 32rpx; color: #6B6560; padding: 4rpx 0 8rpx; }
.foot { min-height: 56rpx; padding-top: 8rpx; }
.legend { font-size: 22rpx; color: #6B6560; flex-wrap: wrap; min-width: 0; }
.legend text { margin: 0 14rpx 0 6rpx; }
.lg-box { padding: 3rpx 4rpx; border-radius: 8rpx; background: #FFE4D6; display: flex; }
.lg-box .ctag { margin-top: 0; }
.lg-sel { width: 28rpx; height: 28rpx; border-radius: 50%; background: #FFE4D6; box-shadow: inset 0 0 0 1px #C64B19; }
.lg-rest { width: 28rpx; height: 28rpx; line-height: 28rpx; border-radius: 50%; background: #EEF2F7; color: #6B7F99; font-size: 18rpx; text-align: center; font-weight: 600; }
.toggle { flex-shrink: 0; padding-left: 16rpx; font-size: 24rpx; color: #5C5854; font-weight: 500; }
.fold-chev { width: 10rpx; height: 10rpx; margin: -6rpx 0 0 10rpx; border-right: 3rpx solid #5C5854; border-bottom: 3rpx solid #5C5854; transform: rotate(45deg); }
.fold-chev.up { margin-top: 6rpx; transform: rotate(-135deg); }
