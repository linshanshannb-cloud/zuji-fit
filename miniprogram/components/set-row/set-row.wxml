<view class="sr {{mode==='time'?'time':''}} {{set.done?'done':''}} {{readonly?'ro':''}}" bindlongpress="onLong">
  <view class="no" bindtap="onType"><text class="{{set.type==='warmup'?'warm':''}}">{{set.type==='warmup'?'热':label}}</text></view>
  <view class="stp w {{mode==='time'?'bare':''}}">
    <view wx:if="{{mode!=='time'}}" class="pm" data-f="weightKg" data-d="-1" bindtap="onStep" catchlongpress="onStepLong" bindtouchend="onStepEnd">−</view>
    <input class="val num {{w===''?'empty':''}}" type="digit" value="{{w}}" placeholder="{{mode==='time' || bodyweight?'自重':'—'}}" placeholder-class="phc" data-f="weightKg" bindfocus="onFocus" bindblur="onBlur" catchlongpress="noop" disabled="{{readonly}}"/>
    <view wx:if="{{mode!=='time'}}" class="pm" data-f="weightKg" data-d="1" bindtap="onStep" catchlongpress="onStepLong" bindtouchend="onStepEnd">+</view>
  </view>
  <view wx:if="{{mode!=='time'}}" class="stp r {{shake?'shake':''}}">
    <view class="pm" data-f="reps" data-d="-1" bindtap="onStep" catchlongpress="onStepLong" bindtouchend="onStepEnd">−</view>
    <input class="val num" type="number" value="{{r}}" placeholder="—" placeholder-class="phc" data-f="reps" bindfocus="onFocus" bindblur="onBlur" catchlongpress="noop" disabled="{{readonly}}"/>
    <view class="pm" data-f="reps" data-d="1" bindtap="onStep" catchlongpress="onStepLong" bindtouchend="onStepEnd">+</view>
  </view>
  <block wx:else>
    <view class="stp d {{shake?'shake':''}}">
      <view class="pm" data-f="durationSec" data-d="-1" bindtap="onStep" catchlongpress="onStepLong" bindtouchend="onStepEnd">−</view>
      <input class="val num" type="number" value="{{d}}" placeholder="秒" placeholder-class="phc" data-f="durationSec" bindfocus="onFocus" bindblur="onBlur" catchlongpress="noop" disabled="{{readonly}}"/>
      <view class="pm" data-f="durationSec" data-d="1" bindtap="onStep" catchlongpress="onStepLong" bindtouchend="onStepEnd">+</view>
    </view>
    <view class="tm" catchtap="onTimer" catchlongpress="noop">计时</view>
  </block>
  <view class="chk" bindtap="onDone"><view class="circle {{set.done?'on':''}}">{{set.done?'✓':''}}</view></view>
</view>
