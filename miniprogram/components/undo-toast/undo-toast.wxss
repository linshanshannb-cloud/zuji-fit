.toast { position: fixed; left: 32rpx; right: 32rpx; background: var(--c-ink); color: var(--c-white); border-radius: var(--r-control); display: flex; align-items: center; justify-content: space-between; padding: 0 32rpx; height: 88rpx; z-index: 60; font-size: 28rpx; }
.t { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.u { color: var(--c-accent); font-weight: 600; padding: 24rpx 0 24rpx 32rpx; }
